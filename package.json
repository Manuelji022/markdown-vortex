{
  "name": "document-retrieval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "node --import tsx/esm server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json && node scripts/prepare-sites-build.mjs",
    "start": "NODE_ENV=production node dist/vps/index.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fastify/middie": "^9.3.3",
    "@fastify/static": "^10.1.3",
    "defuddle": "^0.19.3",
    "fastify": "^5.12.1",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.13"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
